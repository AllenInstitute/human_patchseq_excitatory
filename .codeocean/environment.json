{
	"version": 1,
	"base_image": "codeocean/mambaforge3:24.5.0-0-python3.12.4-ubuntu22.04",
	"post_install": true,
	"options": {
		"registry_host_arg": true,
		"git_ask_pass": true,
		"mount_secrets": true
	},
	"installers": {
		"vscode": {
			"packages": [
				{
					"name": "anthropic.claude-code",
					"version": "2.1.81"
				},
				{
					"name": "ms-python.python",
					"version": "2025.14.0"
				},
				{
					"name": "ms-toolsai.jupyter",
					"version": "2025.4.1"
				},
				{
					"name": "reditorsupport.r",
					"version": "2.8.6"
				},
				{
					"name": "saoudrizwan.claude-dev",
					"version": "3.35.1"
				}
			],
			"version": "4.100.3"
		}
	},
	"env_variables": [
		{
			"name": "CLAUDE_CODE_USE_BEDROCK",
			"value": "1"
		},
		{
			"name": "AWS_REGION",
			"value": "us-west-1"
		}
	]
}